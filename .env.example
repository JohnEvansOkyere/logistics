# API listens locally on this port.
API_PORT=3001

# Browser origin allowed to call the local API.
WEB_ORIGIN=http://127.0.0.1:3000

# Relative paths are resolved from apps/api. This stores the ignored database at
# the repository root in .local/logistics.sqlite.
DATABASE_PATH=../../.local/logistics.sqlite

# The Next.js starter page links to this local API endpoint.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api

# Supabase project HTTPS URL and publishable key for the browser Auth client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL Session pooler URI; server-only. Set to use the API's PostgreSQL
# readiness provider instead of SQLite. Never put this or a secret key in NEXT_PUBLIC_ vars.
DATABASE_URL=

# Download the project's root CA from Supabase Database > SSL Configuration.
# This relative path is resolved from apps/api and points to ignored .local/.
DATABASE_SSL_CA_PATH=../../.local/supabase-root.crt
