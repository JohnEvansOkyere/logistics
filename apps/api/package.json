{
  "name": "@bjh/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "dotenv -e ../../.env -- nest start",
    "start:prod": "node dist/main.js",
    "db:migrate": "dotenv -e ../../.env -- tsx src/database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.e2e-spec.ts",
    "test:e2e": "tsx --test test/*.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "better-sqlite3": "13.0.3",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.11",
    "@types/pg": "8.15.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
